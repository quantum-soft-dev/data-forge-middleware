#!/usr/bin/env bash
# Stand-in for the GitHub CLI in PrMergeScriptTest (issue #332). It records every call, one line per
# call with its arguments tab-separated, and plays GitHub from fixture files in $FAKE_GH_DIR:
#   pr.json      the pull request as `GET repos/…/pulls/<n>` returns it, before any merge
#   merge-mode   what `gh pr merge` does: ok | fatal-after-merge (the merge lands, then gh exits 1 on
#                its local cleanup — the failure #332 is about) | refused (nothing lands, exit 1)
#   delete-mode  what `DELETE git/refs/heads/<b>` does: ok | gone (422, already deleted) | fail (500)
# State the script changes is kept as marker files (`merged`, `deleted`) so a re-read sees it. Anything
# it does not recognise fails loudly, so a `gh pr view` (GraphQL) or `--delete-branch` creeping back
# turns the test red rather than passing against a permissive fake.
set -euo pipefail
log=${FAKE_GH_LOG:?}
dir=${FAKE_GH_DIR:?}

printf '%s\t' "$@" | tr '\n' ' ' >> "$log"
printf '\n' >> "$log"

refuse() { printf 'fake-gh: %s: %s\n' "$1" "${*:2}" >&2; exit 97; }
mode() { [[ -f "$dir/$1" ]] && tr -d '[:space:]' < "$dir/$1" || printf '%s' "$2"; }

if [[ "${1:-} ${2:-}" == "pr merge" ]]; then
  for arg in "$@"; do [[ "$arg" == --delete-branch || "$arg" == -d ]] && refuse "--delete-branch must not be passed" "$@"; done
  case "$(mode merge-mode ok)" in
    ok) touch "$dir/merged"; echo "✓ Squashed and merged pull request" ;;
    fatal-after-merge)
      touch "$dir/merged"
      echo "failed to run git: fatal: 'develop' is already used by worktree at '/repo'" >&2
      exit 1 ;;
    refused) echo "X Pull request is not mergeable: the base branch policy prohibits the merge." >&2; exit 1 ;;
    *) refuse "unknown merge-mode" ;;
  esac
  exit 0
fi

[[ "${1:-}" == api ]] || refuse "only 'gh api' and 'gh pr merge' are expected" "$@"
shift

method=GET endpoint="" jq_expr=""
while (($#)); do
  case "$1" in
    -X|--method) method=$2; shift 2 ;;
    --jq|-q) jq_expr=$2; shift 2 ;;
    --silent) shift ;;
    -*) refuse "unknown flag" "$1" ;;
    *) [[ -z "$endpoint" ]] || refuse "second endpoint" "$1"; endpoint=$1; shift ;;
  esac
done
[[ "$endpoint" != graphql ]] || refuse "GraphQL is not expected" "$endpoint"

answer() { if [[ -n "$jq_expr" ]]; then jq -r "$jq_expr"; else cat; fi; }

case "$method $endpoint" in
  "GET repos/"*"/pulls/"*)
    merged=false; [[ -f "$dir/merged" ]] && merged=true
    jq --argjson m "$merged" \
      'if $m then .merged = true | .state = "closed" | .merge_commit_sha = "0123456789abcdef0123" else . end' \
      "$dir/pr.json" | answer ;;
  "DELETE repos/"*"/git/refs/heads/"*)
    case "$(mode delete-mode ok)" in
      ok) touch "$dir/deleted" ;;
      gone) touch "$dir/deleted"; echo '{"message":"Reference does not exist"}'; echo "gh: Reference does not exist (HTTP 422)" >&2; exit 1 ;;
      fail) echo "gh: Server Error (HTTP 500)" >&2; exit 1 ;;
      *) refuse "unknown delete-mode" ;;
    esac ;;
  "GET repos/"*"/git/ref/heads/"*)
    if [[ -f "$dir/deleted" ]]; then
      echo '{"message":"Not Found"}'; echo "gh: Not Found (HTTP 404)" >&2; exit 1
    fi
    printf '{"ref":"refs/heads/%s"}' "${endpoint#*/git/ref/heads/}" | answer ;;
  *) refuse "unexpected REST call" "$method" "$endpoint" ;;
esac
