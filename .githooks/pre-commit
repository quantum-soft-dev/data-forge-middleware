#!/usr/bin/env bash
#
# Per-task test gate (development policy — see CLAUDE.md "Development Policy").
# Blocks a commit unless the relevant test suite is 100% green.
#
#   - Backend changes  -> ./gradlew test -PexcludeIntegration  (unit + contract, no Docker)
#   - Frontend changes -> tsc --noEmit + eslint + npm --prefix frontend test
#   - Anything else    -> the documentation guards (com.bitbi.dfm.documentation.*):
#                         a leftover merge-conflict line can land in any tracked file (#342)
#   - Manifests        -> the deployment manifest guards
#
# Integration (Testcontainers) tests are NOT run here — they are the before-PR gate
# (`./gradlew integrationTest`) and the CI required check on PRs to develop.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Emergency bypass (discouraged, against policy):   git commit --no-verify

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# D/R included: deleting or renaming a still-imported module is exactly the
# breakage class the typecheck gate exists for. --name-status (not --name-only)
# because a rename entry lists BOTH paths — a move out of frontend/ or away
# from *.java must still trigger the gate of the side that lost the file.
staged="$(git diff --cached --name-status --diff-filter=ACMDR | awk '{ for (i = 2; i <= NF; i++) print $i }')"
[ -z "$staged" ] && exit 0

backend_changed=false
frontend_changed=false
documentation_changed=false
scratch_manifest_changed=false

while IFS= read -r f; do
  case "$f" in
    frontend/*)
      frontend_changed=true ;;
    AGENTS.md|CLAUDE.md|src/main/resources/db/migration/*)
      documentation_changed=true ;;
    scripts/issue-base.sh|scripts/board.sh|scripts/wave.sh|scripts/issue-find.sh|scripts/pr-merge.sh|src/test/resources/process/*|.github/ISSUE_TEMPLATE/*)
      # The one reading of an issue's `Base branch:` line (#298), the board script's GraphQL spend
      # (#311), the search that must not go silently empty (#308), the issue forms that teach
      # that line (#310) and the merge step that must not read gh's exit code as its verdict
      # (#332) are guarded from the same package; a script- or forms-only commit is
      # exactly the one that can break them.
      documentation_changed=true ;;
    k8s/*)
      # Decisions that live in the manifests and are asserted from tests: the pod-private scratch
      # claim (#141), the scratch ceilings under the volume (#138/#150), the UTC container zone
      # (#280), where the S3 orphan sweep may delete (#351) and what the backend HPA scales on
      # (#350). A manifest-only commit is exactly the one that can break them.
      scratch_manifest_changed=true ;;
    *.java|build.gradle.kts|settings.gradle.kts|gradle.properties|gradle/*|gradlew*)
      backend_changed=true ;;
    *)
      # docs/, specs/, .claude/commands/, README.md, configuration: ConflictMarkerLineTest reads
      # every tracked file (#342), and before this branch a commit touching only these ran no
      # guard at all, so a leftover merge-conflict line there reached develop unseen.
      documentation_changed=true ;;
  esac
done <<< "$staged"

status=0

if [ "$documentation_changed" = true ] && [ "$backend_changed" = false ]; then
  echo "▶ pre-commit: documentation guards"
  # The whole package rather than one class: every guard over AGENTS.md / CLAUDE.md lives here
  # (migration pointers #104, the Recent Changes journal #278), and a docs-only commit is exactly
  # the one that can break any of them. Naming classes one by one is how the next guard is added
  # and silently never run.
  if ! ./gradlew test -PexcludeIntegration \
      --tests 'com.bitbi.dfm.documentation.*' \
      --no-daemon --console=plain; then
    echo "✖ Agent documentation drift detected — commit blocked."
    status=1
  fi
fi

if [ "$scratch_manifest_changed" = true ] && [ "$backend_changed" = false ]; then
  echo "▶ pre-commit: deployment manifest guards"
  if ! ./gradlew test -PexcludeIntegration \
      --tests com.bitbi.dfm.delta.application.ParquetScratchOrphanSweeperTest \
      --tests com.bitbi.dfm.delta.application.ParquetScratchCeilingBudgetTest \
      --tests com.bitbi.dfm.config.ContainerTimeZoneContractTest \
      --tests com.bitbi.dfm.delta.application.S3OrphanSweepDeploymentTest \
      --tests com.bitbi.dfm.config.HpaScalingPolicyDeploymentTest \
      --no-daemon --console=plain; then
    echo "✖ The manifests disagree with a decision a test holds — commit blocked."
    status=1
  fi
fi

if [ "$backend_changed" = true ]; then
  echo "▶ pre-commit: backend tests (./gradlew test -PexcludeIntegration)"
  if ! ./gradlew test -PexcludeIntegration --no-daemon --console=plain; then
    echo "✖ Backend tests failed — commit blocked (policy: 100% green per task)."
    status=1
  fi
fi

if [ "$frontend_changed" = true ]; then
  # vitest alone misses compile-only breakage (production build is tsc && vite build)
  echo "▶ pre-commit: frontend typecheck (tsc --noEmit)"
  if ! (cd frontend && npx tsc --noEmit); then
    echo "✖ Frontend typecheck failed — commit blocked (npm run build would fail)."
    status=1
  fi

  # Lint is at zero findings (issue #77) — it stays there by being a gate.
  echo "▶ pre-commit: frontend lint (npm --prefix frontend run lint)"
  if ! npm --prefix frontend run lint; then
    echo "✖ Frontend lint failed — commit blocked (0 errors / 0 warnings is the bar)."
    status=1
  fi

  echo "▶ pre-commit: frontend tests (npm --prefix frontend test)"
  if ! npm --prefix frontend test; then
    echo "✖ Frontend tests failed — commit blocked (policy: 100% green per task)."
    status=1
  fi
fi

if [ "$backend_changed" = false ] && [ "$frontend_changed" = false ] \
    && [ "$documentation_changed" = false ] && [ "$scratch_manifest_changed" = false ]; then
  echo "▶ pre-commit: no backend/frontend changes staged — test gate skipped."
fi

exit "$status"
