#!/usr/bin/env bash
#
# Per-task test gate (development policy — see CLAUDE.md "Development Policy").
# Blocks a commit unless the relevant test suite is 100% green.
#
#   - Backend changes  -> ./gradlew test -PexcludeIntegration  (unit + contract, no Docker)
#   - Frontend changes -> tsc --noEmit + eslint + npm --prefix frontend test
#   - Docs/config-only -> skipped, except the focused migration-documentation guard
#
# Integration (Testcontainers) tests are NOT run here — they are the before-PR gate
# (`./gradlew integrationTest`) and the CI required check on PRs to develop.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Emergency bypass (discouraged, against policy):   git commit --no-verify

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# D/R included: deleting or renaming a still-imported module is exactly the
# breakage class the typecheck gate exists for. --name-status (not --name-only)
# because a rename entry lists BOTH paths — a move out of frontend/ or away
# from *.java must still trigger the gate of the side that lost the file.
staged="$(git diff --cached --name-status --diff-filter=ACMDR | awk '{ for (i = 2; i <= NF; i++) print $i }')"
[ -z "$staged" ] && exit 0

backend_changed=false
frontend_changed=false
migration_guidance_changed=false

while IFS= read -r f; do
  case "$f" in
    frontend/*)
      frontend_changed=true ;;
    AGENTS.md|CLAUDE.md|src/main/resources/db/migration/*)
      migration_guidance_changed=true ;;
    *.java|build.gradle.kts|settings.gradle.kts|gradle.properties|gradle/*|gradlew*)
      backend_changed=true ;;
  esac
done <<< "$staged"

status=0

if [ "$migration_guidance_changed" = true ] && [ "$backend_changed" = false ]; then
  echo "▶ pre-commit: migration documentation consistency"
  if ! ./gradlew test -PexcludeIntegration \
      --tests com.bitbi.dfm.documentation.MigrationDocumentationConsistencyTest \
      --no-daemon --console=plain; then
    echo "✖ Migration documentation drift detected — commit blocked."
    status=1
  fi
fi

if [ "$backend_changed" = true ]; then
  echo "▶ pre-commit: backend tests (./gradlew test -PexcludeIntegration)"
  if ! ./gradlew test -PexcludeIntegration --no-daemon --console=plain; then
    echo "✖ Backend tests failed — commit blocked (policy: 100% green per task)."
    status=1
  fi
fi

if [ "$frontend_changed" = true ]; then
  # vitest alone misses compile-only breakage (production build is tsc && vite build)
  echo "▶ pre-commit: frontend typecheck (tsc --noEmit)"
  if ! (cd frontend && npx tsc --noEmit); then
    echo "✖ Frontend typecheck failed — commit blocked (npm run build would fail)."
    status=1
  fi

  # Lint is at zero findings (issue #77) — it stays there by being a gate.
  echo "▶ pre-commit: frontend lint (npm --prefix frontend run lint)"
  if ! npm --prefix frontend run lint; then
    echo "✖ Frontend lint failed — commit blocked (0 errors / 0 warnings is the bar)."
    status=1
  fi

  echo "▶ pre-commit: frontend tests (npm --prefix frontend test)"
  if ! npm --prefix frontend test; then
    echo "✖ Frontend tests failed — commit blocked (policy: 100% green per task)."
    status=1
  fi
fi

if [ "$backend_changed" = false ] && [ "$frontend_changed" = false ] \
    && [ "$migration_guidance_changed" = false ]; then
  echo "▶ pre-commit: no backend/frontend changes staged — test gate skipped."
fi

exit "$status"
