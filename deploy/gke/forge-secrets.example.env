# forge-secrets — template of the Kubernetes Secret the backend reads via envFrom.
# Copy to forge-secrets.<env>.env, fill real values, and apply with sync-secrets.sh.
# NEVER commit the filled file (see .gitignore).

# --- Database (Cloud SQL `dfm` on dev-bitbi-db; private IP) ---
DB_URL=jdbc:postgresql://10.225.0.9:5432/dfm
DB_USERNAME=dfm-app
DB_PASSWORD=

# --- Client API v1 JWT signing key (min 32 chars / 256-bit) ---
JWT_SECRET=

# --- Auth0 Management API (M2M) ---
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# --- Object storage: GCS HMAC keys (S3-compatible) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Redis password (empty for the in-cluster dev Redis, which has no auth) ---
SPRING_DATA_REDIS_PASSWORD=

# --- Bit BI plugin: Auth0 client id of the Bit BI app ---
PLUGIN_BITBI_CLIENT_ID=
