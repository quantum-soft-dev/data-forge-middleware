# Keycloak Configuration
# Default values match .env.development for consistency
# For production deployment, update these to match your Keycloak server
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=dfm
VITE_KEYCLOAK_CLIENT_ID=dfm-ui

# API Configuration
VITE_API_BASE_URL=http://localhost:8080

# Debug Configuration (optional)
# Uncomment to enable authentication debug logging in development
# REACT_APP_DEBUG_AUTH=true

# Local Overrides
# Create .env.local (gitignored) to override any values above for your local setup
