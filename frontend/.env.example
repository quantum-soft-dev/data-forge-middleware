# Auth0 Configuration
# For production deployment, update these to match your Auth0 tenant
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id
VITE_AUTH0_AUDIENCE=https://your-api-audience.example.com

# Auth0 Custom Claims Namespace
# Must match the namespace used in your Auth0 Post-Login Action
VITE_AUTH0_CLAIMS_NAMESPACE=https://your-domain.example.com

# API Configuration
VITE_API_BASE_URL=http://localhost:8080

# Debug Configuration (optional)
# Uncomment to enable authentication debug logging in development
# REACT_APP_DEBUG_AUTH=true

# Local Overrides
# Create .env.local (gitignored) to override any values above for your local setup
