# Auth0 Configuration
# Copy this file to .env.local and fill in your Auth0 credentials
# DO NOT commit .env.local to git!

# Auth0 Tenant Domain (e.g., dev-example.us.auth0.com)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com

# Auth0 Single Page Application Client ID
VITE_AUTH0_CLIENT_ID=your-spa-client-id-here

# Auth0 API Audience (API Identifier from Auth0 Dashboard)
VITE_AUTH0_AUDIENCE=https://api.dataforge.com
