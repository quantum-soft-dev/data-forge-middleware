# Data Forge Frontend - Environment Variables (Local Development)
# ⚠️ Copy to .env.local for local development: cp .env.local.example .env.local
# ⚠️ NEVER commit .env.local to version control!

# ============================================
# Auth0 Configuration (REQUIRED)
# ============================================
# Auth0 Tenant Domain (from Auth0 Dashboard)
# Example: dev-abc123.us.auth0.com or dev-abc123.eu.auth0.com
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com

# Single Page Application Client ID (NOT the M2M client ID!)
# Get from: Auth0 Dashboard → Applications → Data Forge Admin UI → Client ID
VITE_AUTH0_CLIENT_ID=your-spa-client-id-here

# API Audience (API Identifier, same as backend AUTH0_AUDIENCE)
# Get from: Auth0 Dashboard → Applications → APIs → Data Forge API → Identifier
VITE_AUTH0_AUDIENCE=https://api.dataforge.com

# Custom claims namespace (must match backend AUTH0_CLAIMS_NAMESPACE and your Auth0 Action)
VITE_AUTH0_CLAIMS_NAMESPACE=https://api.dataforge.com

# ============================================
# Backend API Configuration
# ============================================
VITE_API_BASE_URL=http://localhost:8080

# ============================================
# Setup Instructions
# ============================================
# 1. Copy this file to .env.local:
#    cp .env.local.example .env.local
#
# 2. Get SPA credentials from Auth0 Dashboard:
#    Applications → Data Forge Admin UI (Single Page Application)
#    - Copy Domain → update VITE_AUTH0_DOMAIN
#    - Copy Client ID → update VITE_AUTH0_CLIENT_ID
#
# 3. ⚠️ IMPORTANT: Use SPA Client ID, NOT M2M Client ID!
#    - SPA = for browser authentication (this frontend)
#    - M2M = for backend server-to-server calls
#
# 4. Verify Allowed Callback URLs in Auth0 Dashboard:
#    Applications → Data Forge Admin UI → Settings
#    Must include: http://localhost:3000
#
# 5. Start frontend dev server:
#    npm run dev
#
# 6. Open browser: http://localhost:3000
#
# For backend configuration see: ../.env.example
