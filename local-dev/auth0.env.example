# Real Auth0 tenant for the LOCAL backend (dev profile). Copy to `auth0.env` and fill in.
#   cp local-dev/auth0.env.example local-dev/auth0.env   &&   $EDITOR local-dev/auth0.env
# Then run:  ./local-dev/run-with-auth0.sh
#
# IMPORTANT: AUTH0_ISSUER and AUTH0_MGMT_AUDIENCE are NOT derived from AUTH0_DOMAIN in
# application-dev.yml — they have their own dev-example defaults. Set all of them, consistently.
# (auth0.env is gitignored below — never commit real secrets.)

# Tenant domain (no scheme, no trailing slash)
export AUTH0_DOMAIN=your-tenant.us.auth0.com

# Resource-server (token validation). issuer MUST end with a slash and match the token `iss`.
export AUTH0_ISSUER=https://your-tenant.us.auth0.com/
export AUTH0_AUDIENCE=https://api.dataforge.com
# Only if your Post-Login Action emits claims under a different namespace
# (default https://api.dataforge.com from application.yml):
# export AUTH0_CLAIMS_NAMESPACE=https://api.dataforge.com

# Management API (M2M app authorized for the Auth0 Management API)
export AUTH0_MGMT_CLIENT_ID=your_m2m_client_id
export AUTH0_MGMT_CLIENT_SECRET=your_m2m_client_secret
export AUTH0_MGMT_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/

# localstack bucket override (dev default is data-forge-bucket; localstack creates dfm-uploads)
export AWS_S3_BUCKET_NAME=dfm-uploads

# NOTE: do NOT set JWT_SECRET here — leaving it lets the Delta HS256 helpers
# (local-dev/mint-token.py) keep using the dev profile's fixed jwt.secret.
